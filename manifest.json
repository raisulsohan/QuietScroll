{
  "manifest_version": 3,
  "name": "QuietScroll",
  "version": "1.6",
  "description": "Smart per-site volume control for peaceful browsing. Night mode, quick presets, ultra-low night listening, volume guard, and smooth Alt + Wheel control. Made by Raisul Sohan.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuietScroll"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["guard.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}